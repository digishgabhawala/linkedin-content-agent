# Where the app's data lives. Unset = local SQLite at DB_PATH. For Supabase,
# use the pooler URL; DB_SCHEMA keeps this app's tables in their own schema.
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DB_SCHEMA=linkedin
DB_PATH=posts.db
DEFAULT_CHARACTER_ID=gtee_dev
CLARIFY_MAX_TURNS=5
MAX_RECALIBRATION_PASSES=3
# TASK_QUEUE_URL is the queue's canonical public product URL. The app maps
# its /queue page to the sibling /api/queue API. Local dev still defaults to
# the task-queue uvicorn origin and maps that to /api.
TASK_QUEUE_URL=http://127.0.0.1:8000
# Production: TASK_QUEUE_URL=https://ai-bharatiya-web.vercel.app/queue
# This app's machine key for the task-queue (its sha256 goes in task-queue's
# SERVICE_API_KEYS); needed once the hosted queue has auth enabled.
# TASK_QUEUE_API_KEY=<raw key>
IMAGE_STALL_TIMEOUT_MINUTES=40
# Every compute step (category/clarify/draft/judge/scene/image) is one
# task-queue task run by the worker -- this app never calls an LLM itself.
# Max minutes a queued step may wait for a worker before it expires:
STEP_MAX_WAIT_MINUTES=60
# USER_PROFILE_PATH/SKILL_PATH/EXAMPLE_POSTS_PATH/SCENE_EXAMPLES_PATH default
# to content_config/*.md (relative to cwd, i.e. backend/) -- see that
# directory and CONTENT_QUALITY_DESIGN.md. Only set these if you've moved
# or renamed those files.
# Login (same approach as task-queue's admin page). Off by default for local
# development; production sets AUTH_ENABLED=true and the three values below
# (same Supabase project as task-queue). Verified tokens are trusted for
# AUTH_CACHE_MINUTES before Supabase is asked again.
# AUTH_ENABLED=true
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=<browser-safe publishable key>
# AUTH_ALLOWED_EMAILS=you@example.com
# AUTH_CACHE_MINUTES=15
