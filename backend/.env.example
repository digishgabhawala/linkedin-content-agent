OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:14b
DB_PATH=posts.db
GENERATED_DIR=generated
DEFAULT_CHARACTER_ID=gtee_dev
CLARIFY_MAX_TURNS=5
MAX_RECALIBRATION_PASSES=3
# CHARACTER_FORGE_V2_PATH defaults to an absolute sibling path computed from
# this file's location (see config.py) -- only used for direct filesystem
# reads now (character personality, local hero.png placeholder), not for
# actual image generation. Only set this if your layout differs from the
# standard personal-productivity-tools/ tree.
# CHARACTER_FORGE_V2_PATH=/absolute/path/to/character-forge-v2
# TASK_QUEUE_URL points at the task-queue service that actually performs
# image generation (see the sibling task-queue repo) -- local dev default
# matches its own local `uvicorn` default port. Point this at the real
# Vercel deployment URL to use a remote/shared queue instead.
TASK_QUEUE_URL=http://127.0.0.1:8000
IMAGE_STALL_TIMEOUT_MINUTES=40
# USER_PROFILE_PATH/SKILL_PATH/EXAMPLE_POSTS_PATH/SCENE_EXAMPLES_PATH default
# to content_config/*.md (relative to cwd, i.e. backend/) -- see that
# directory and CONTENT_QUALITY_DESIGN.md. Only set these if you've moved
# or renamed those files.
